---
/** Mobile header bar. Sits inside the 375px canvas; the menu it opens is
    rendered outside the canvas by MobileMenu.astro. */
---

<header
  style="position:absolute;top:0;left:0;width:375px;padding:15px 20px;display:flex;align-items:center;justify-content:space-between;background:#070028;z-index:40"
>
  <a href="/" style="display:flex;gap:10px;align-items:center;cursor:pointer">
    <span
      aria-hidden="true"
      style="background:#895dff;display:flex;align-items:center;justify-content:center;border-radius:9px;width:36px;height:36px;font-family:var(--font-manrope);font-weight:700;font-size:13px;color:#130d00"
      >RM</span
    >
    <span style="font-family:var(--font-manrope);font-weight:700;font-size:18px;color:#fff"
      >Rovex <span style="color:#895dff">Media</span></span
    >
  </a>

  <button
    type="button"
    class="mnav-open"
    aria-label="Open menu"
    aria-controls="mobile-menu"
    aria-expanded="false"
    style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:-10px -10px -10px 0;padding:0;border:0;background:none"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M4 5H20M4 12H10M4 19H20"
        stroke="#fff"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</header>
